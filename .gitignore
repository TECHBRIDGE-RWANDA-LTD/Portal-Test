# Backend .gitignore (Django REST Framework)

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Media / Uploaded files (except keep directory structure)
media/documents/*
!media/documents/.gitkeep

# IDEs
.vscode/
.idea/
.seed_data.py
